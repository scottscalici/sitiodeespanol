rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Everything here is content shown on the public site (curiosidades
    // images, etc.), so anyone can read. Only an admin account can write —
    // same role check as firestore.rules — and only images up to 10MB,
    // matching the client-side cap in src/utils/imageUpload.js.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
