rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isLoggedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- CONFIG & NOTES ---
    match /config/{document=**} {
      allow read: if true;
      allow write: if true; // Allows calendar edits from the unauthenticated admin portal
    }

    match /configNotes/{document=**} {
      allow read, write: if true;
    }

    // --- USER REGISTRATION & PROFILES ---
    match /users/{userId} {
      allow read: if true; // Allows admin scheduler to read student names/emails without login

      // Only the account owner can create their own profile doc, and can only
      // grant themselves the 'admin' role if their auth email is the site owner's.
      // Everyone else (including anonymous guests, if they ever write here) may
      // only self-assign 'student'.
      allow create: if isLoggedIn()
                    && request.auth.uid == userId
                    && (
                      request.resource.data.role == 'student'
                      || (request.resource.data.role == 'admin'
                          && request.auth.token.email == 'scott.scalici@uticak12.org')
                    );

      // Owners may update their own doc but cannot change their own role.
      // Admins may update anyone's doc, including role changes (e.g. promoting a TA).
      allow update: if isLoggedIn()
                    && (
                      isAdmin()
                      || (request.auth.uid == userId
                          && request.resource.data.role == resource.data.role)
                    );

      allow delete: if isAdmin();
    }

    // If your app uses a separate 'students' collection:
    match /students/{document=**} {
      allow read, write: if true;
    }

    // --- MEETING SCHEDULER & ADMIN PORTAL ---
    match /bookings/{document=**} {
      allow read, write: if true;
    }

    match /scheduler_settings/{document=**} {
      allow read, write: if true;
    }

    match /scheduler_overrides/{document=**} {
      allow read, write: if true;
    }

    // --- PROTECTED STUDENT DATA & GRADES ---
    // Doc ID (and any subcollections under it) keyed by the student's own auth uid.
    // Owner can read/write their own record; admins (teachers) can read/write any.
    match /studentData/{userId}/{document=**} {
      allow read, write: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- IMPOSTOR GAME (ephemeral multiplayer lobbies) ---
    // Any logged-in user (student or admin) needs to create/join rooms and
    // update player state — this is a low-stakes real-time game session,
    // not protected student data, so it doesn't need admin-only writes.
    match /impostor_rooms/{document=**} {
      allow read, write: if isLoggedIn();
    }

    // --- RECUPERACIÓN (reflection + practice gate attempts) ---
    // Doc ID is `${uid}__${circleId}`, but that's not checkable directly, so
    // ownership is verified against the document's own `uid` field instead —
    // a student may only create/update their own record (submitting their
    // reflection, recording a gate attempt); an admin (teacher) can read
    // every student's record for the eligibility list, but never write one.
    match /recuperaciones/{docId} {
      allow read: if isLoggedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isLoggedIn() && resource.data.uid == request.auth.uid;
    }

    // --- LEADERBOARD HISTORY (Hall of Fame weekly/monthly archives) ---
    // Snapshotted client-side by the first student in a course to earn
    // points in a new week/month (see archivePeriodIfNeeded in
    // pointsHelper.js) — low-stakes derived data (top 3 scorers of the
    // period that just ended), not itself a grade, so any logged-in user
    // may write it, same posture as impostor_rooms above.
    match /leaderboard_history/{document=**} {
      allow read, write: if isLoggedIn();
    }

    // --- THE MASTER CATCH-ALL (Curriculum & Other Apps) ---
    match /{document=**} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }
  }
}
