  },
  "styles": {
    "header": "bg-gradient-to-r from-[#1a0033] via-[#ff6b00] to-[#000000]",
    "pageBackground": "bg-gradient-to-br from-[#0d0014] to-[#1a0033]",
    "accent": "#ff6b00",
    "accentShades": { "light": "#ffb366", "dark": "#b34c00" },

    "fontHeading": "Creepster",
    "fontMono": "Jolly Lodger",
    "fonts": { "cardTitle": "Jolly Lodger", "body": "Nunito", "accent": "Butcherman" },
    "fontList": [
      { "name": "Creepster", "weights": [400] },
      { "name": "Jolly Lodger", "weights": [400] },
      { "name": "Butcherman", "weights": [400] },
      { "name": "Nunito", "weights": [400, 700] }
    ],

    "textEffects": {
      "presets": {
        "flicker": {
          "keyframes": "0%,19%,21%,23%,25%,54%,56%,100%{opacity:.99;filter:drop-shadow(0 0 8px #fbbf24) drop-shadow(0 0 16px #f59e0b)} 20%,24%,55%{opacity:.8;filter:drop-shadow(0 0 4px #f59e0b)}",
          "duration": "2.5s"
        }
      },
      "assignments": { "headerTitle": "flicker" }
    },

    "cardStyles": {
      "pumpkin": { "background": "#ff6b00", "text": "#2d1200", "heading": "#2d1200", "border": "#b34c00" },
      "crypt": { "background": "#0d0503", "text": "#e5c9a8", "heading": "#ff6b00", "border": "#3a0000" },
      "potion": { "background": "#3d1a5c", "text": "#c8f564", "heading": "#c8f564", "border": "#8a4fd6" },
      "midnight": { "background": "#0f172a", "text": "#93c5fd", "heading": "#60a5fa", "border": "#1e3a8a" }
    },
    "cardStyleAssignments": {
      "calentamiento": "pumpkin",
      "evaluacion": "crypt",
      "vocabulario": "potion",
      "tareas": "midnight"
