    "cardStyleRotation": ["pumpkin", "crypt", "potion", "midnight"],

    "cardBorderDefault": {
      "width": 3,
      "radius": 16,
      "leftAccent": true,
      "glow": "0 0 14px rgba(255,107,0,0.45)"
