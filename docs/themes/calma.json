{
  "id": "calma",
  "name": "Calma",
  "start": "",
  "end": "",
  "styles": {
    "header": "bg-gradient-to-r from-[#0f766e] via-[#0e7490] to-[#075985]",
    "pageBackground": "bg-gradient-to-br from-[#f0f9ff] to-[#e0f2fe]",
    "accent": "#0e7490",
    "accentShades": { "light": "#67e8f9", "dark": "#164e63" },

    "fontHeading": "Quicksand",
    "fonts": { "cardTitle": "Quicksand", "body": "Nunito Sans", "accent": "Caveat" },
